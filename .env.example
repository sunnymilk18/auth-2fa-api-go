# Server
PORT=8080

# PostgreSQL (persistent user data)
# Local:  postgres://postgres:postgres@localhost:5432/auth2fa?sslmode=disable
# Neon:   copy the "Connection string" from your Neon project dashboard (already includes sslmode=require)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/auth2fa?sslmode=disable

# Redis (short-lived OTP codes)
# Local:   redis://localhost:6379/0
# Upstash: copy the "redis://" or "rediss://" URL from your Upstash database dashboard
REDIS_URL=redis://localhost:6379/0

# JWT secrets - generate strong random values, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# OTP settings
OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_TRIES=5

# SMTP (Gmail App Password - development only, see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pruebacodigo485@gmail.com
SMTP_PASSWORD=
SMTP_FROM=pruebacodigo485@gmail.com
