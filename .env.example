# Server
PORT=8080

# Set to true ONLY if a reverse proxy you control sits in front and
# overwrites (not appends to) X-Forwarded-For — otherwise leave false, since
# a client could forge that header to dodge the login/OTP/register rate
# limits.
TRUST_PROXY_HEADERS=false

# PostgreSQL (persistent user data)
# Local:  postgres://postgres:postgres@localhost:5432/auth2fa?sslmode=disable
# Neon:   copy the "Connection string" from your Neon project dashboard (already includes sslmode=require)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/auth2fa?sslmode=disable

# Optional: DB-backed tests (go test ./...) use this instead of POSTGRES_DSN
# if set, so `go test` never touches your dev database. Point it at a
# throwaway local database (e.g. `CREATE DATABASE auth2fa_test;`) — tests
# apply migrations to it automatically and clean up their own rows.
# Tests needing Postgres are skipped (not failed) if neither DSN connects.
TEST_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/auth2fa_test?sslmode=disable

# Redis (short-lived OTP codes)
# Local:   redis://localhost:6379/0
# Upstash: copy the "redis://" or "rediss://" URL from your Upstash database dashboard
REDIS_URL=redis://localhost:6379/0

# Access tokens (RS256) - generate a keypair (see README) and point here:
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_KEY_ID=auth-2fa-api-1

# Alternative to JWT_PRIVATE_KEY_PATH for platforms with no persistent
# filesystem — base64 of keys/private.pem's contents. Takes priority over
# JWT_PRIVATE_KEY_PATH when set. See README's "Deploy en producción".
# JWT_PRIVATE_KEY_PEM_BASE64=

# Both optional, set together ONLY while rotating the JWT signing key above
# — the PREVIOUS key's id + public key (never the private key — it's not
# used for signing anymore, only kept around so tokens it already signed
# keep verifying for a while). See README's "Rotación de claves JWT" for
# the actual procedure; leave both empty otherwise.
# JWT_PREVIOUS_KEY_ID=
# JWT_PREVIOUS_PUBLIC_KEY_PEM_BASE64=

# Refresh tokens (HS256, internal only) - generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# OTP settings
OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_TRIES=5

# Password reset: a short numeric code, same default length as OTP_LENGTH
# — hashed + attempt-limited in Redis, same as the OTP above.
PASSWORD_RESET_TTL=1h
PASSWORD_RESET_CODE_LENGTH=6
PASSWORD_RESET_MAX_TRIES=5

# Email verification: required before /auth/login will work at all — see
# README's "Verificación de correo" section for why. Same short-code shape
# as above; TTL defaults much longer (a day) since confirming a new account
# is lower urgency than a login or reset already in progress.
EMAIL_VERIFICATION_TTL=24h
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_MAX_TRIES=5

# Per-account login throttle (on top of the per-IP rate limit on
# /auth/login) — catches password guessing spread across many IPs against
# one account. Temporary, not a permanent lockout: resets on the next
# successful login, or after this window passes with no new failures.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW=15m

# Trusted device + PIN (shortcut around password+OTP on a known device)
DEVICE_TRUST_TTL=720h
DEVICE_PIN_MAX_TRIES=5

# Resend (https://resend.com) - HTTP API, not SMTP, so it isn't blocked by
# hosts that filter outbound SMTP ports (many do, including Render).
# Sign up, copy an API key from the dashboard. RESEND_FROM defaults to
# Resend's own sandbox sender (onboarding@resend.dev), which needs no setup
# but only delivers to the email address on your Resend account - verify a
# real domain in the dashboard to send to anyone else.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Enables POST/GET /admin/clients/* - the same operations as
# `go run ./cmd/createclient`, over HTTP instead of the CLI, gated behind
# this one shared secret in the X-Admin-Token header. Generate one like
# any other high-entropy secret, e.g.:
#   openssl rand -base64 48
# Left empty (the default), /admin/* doesn't exist at all - not "open with
# no auth", genuinely unregistered. Never share this token the way you
# would a tenant's own X-API-Key: it can mint/rotate/deactivate *any*
# tenant's key, not just act as one.
ADMIN_API_TOKEN=

# Enables POST /auth/totp/enroll|confirm|disable — an optional
# authenticator-app (Google Authenticator, Authy, etc.) second factor an
# account can activate as an alternative to the emailed OTP code. Base64 of
# exactly 32 raw bytes (AES-256), used to encrypt each account's TOTP secret
# at rest — generate one like any other high-entropy secret:
#   openssl rand -base64 32
# Left empty (the default), /auth/totp/* doesn't exist at all (404, not
# "exists but always fails") — same reasoning as ADMIN_API_TOKEN.
TOTP_ENCRYPTION_KEY=
# Label shown next to the account name in the authenticator app. Purely
# cosmetic — change it to your own product/company name.
TOTP_ISSUER=auth-2fa-api

# Enables push-notification login approval — a third, optional 2FA method
# (alongside email OTP and TOTP) where a login on one device is confirmed
# with a tap on an already-paired phone, instead of typing a code. Path to
# a Firebase service account JSON key file (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). Left empty
# (the default), the /auth/devices/{id}/push, /auth/login/push-status and
# /auth/login/push-answer routes don't exist at all (404, not "exists but
# always fails") — same reasoning as TOTP_ENCRYPTION_KEY/ADMIN_API_TOKEN.
# Keep this file out of version control (it already matches the /keys/
# .gitignore rule if placed there).
FIREBASE_CREDENTIALS_PATH=

# Alternative to FIREBASE_CREDENTIALS_PATH for a platform with no
# persistent/writable filesystem (or where a supposedly bind-mounted path
# silently isn't what the running container actually sees) — base64 of the
# service account JSON file's raw contents. Takes priority over
# FIREBASE_CREDENTIALS_PATH when set. Same reasoning as
# JWT_PRIVATE_KEY_PEM_BASE64. Generate with:
#   base64 -w0 keys/firebase-service-account.json
# or, PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("keys/firebase-service-account.json"))
# FIREBASE_CREDENTIALS_JSON_BASE64=

# How long a pending push-approval request stays valid before it expires
# unanswered — the PC polls PUSH_LOGIN_TTL's window waiting for the phone.
PUSH_LOGIN_TTL=60s

# Per-account cap on how many push-approval requests can be started within
# PUSH_REQUEST_WINDOW — the actual defense against "MFA fatigue" spam (an
# attacker who already knows the password triggering a flood of prompts
# hoping for one accidental tap). Separate from LOGIN_MAX_FAILED_ATTEMPTS,
# which only tracks failed passwords.
PUSH_MAX_REQUESTS=5
PUSH_REQUEST_WINDOW=15m

# OpenTelemetry: exports metrics + logs over OTLP to a collector (see
# docker-compose.yml's otel-collector service and README's
# "Observabilidad" section) — Prometheus for metrics, Loki for logs,
# viewed through Grafana. Optional: left empty (the default), the API
# runs identically, it just doesn't export anything (logs still show up
# on stdout either way).
#
# Must be a full URL WITH scheme (e.g. http://otel-collector:4318), not
# a bare host:port — the OTel SDK reads this same variable internally in
# addition to the app's own code, and without a scheme it treats the
# whole value as a path instead of a host, producing a broken final URL.
OTEL_EXPORTER_OTLP_ENDPOINT=
