            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "OTP verification attempts by outcome (/auth/verify-otp)",
      "description": "200 = código correcto, 401 = código inválido o sesión expirada, 429 = demasiados intentos. Un pico sostenido de 401 sugiere alguien probando códigos al azar contra un login_token robado.",
